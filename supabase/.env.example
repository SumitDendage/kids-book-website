# Secrets for the "api" Edge Function. Set them in the Supabase Dashboard →
# Edge Functions → Secrets (or: supabase secrets set --env-file supabase/.env).
# Never put these in the website's .env — the website only gets the API address.
# SUPABASE_URL, SUPABASE_DB_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEYS,
# SUPABASE_PUBLISHABLE_KEYS and SUPABASE_JWKS are provided by Supabase automatically.

# Where the website lives (links in emails point here) and who may call the API.
SITE_URL=https://learnwithwhy.in
ALLOWED_ORIGINS=https://learnwithwhy.in,https://www.learnwithwhy.in

# Email (pick one provider). MAIL_FROM must be an address on a domain verified with it.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
# RESEND_API_KEY=
MAIL_FROM=Learn With Why <hello@learnwithwhy.in>

# Razorpay (India). Webhook URL: https://<ref>.supabase.co/functions/v1/api/pay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (outside India, optional). Webhook URL: …/functions/v1/api/pay/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (outside India, optional). Webhook URL: …/functions/v1/api/pay/paypal/webhook
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Send the customer's address to Supabase Auth so its sign-in limits count per person,
# not per server (needs an sb_secret_ key; see docs/SETUP.md).
AUTH_FORWARD_IP=true

# Only if the project still signs tokens with the legacy shared secret and you want the API
# to check them without asking Supabase Auth each time. Optional.
# LWW_JWT_SECRET=

# Supabase Auth > Hooks > Send Email signing secret. Backend only.
# Endpoint: /functions/v1/api/auth/send-email
SEND_EMAIL_HOOK_SECRET=
