# dependencies & builds
node_modules/
.next/
out/

# secrets / local
.env
.env.local
*.local
.DS_Store

# zip archives (e.g. backend-and-database.zip unpacked in this folder) are never uploaded
*.zip

# editor / tooling
.claude/*
# ...except the shared project settings, which turn on Claude Code plugins (e.g. Hostinger) for this repo
!.claude/settings.json
__pycache__/

# the backend (server, private PDFs, settings) and the databases are kept OFF GitHub on purpose
# (October 2026): they live only on the owner's computer and the server, next to frontend/.
/backend/
/database/

# left behind on older checkouts after the move to frontend/ (October 2026)
/react-app/
/site/


# supabase/ (the server program and database steps, no keys) IS on GitHub since 15 October 2026 (Sumit).
# Its local secrets never are:
/supabase/.env
/supabase/.temp/
/supabase/.git/
