# dependencies & builds
node_modules/
.next/
out/
archive/papercub-react/dist/

# secrets / local — backend/.env holds the real settings and is never committed (this rule).
# site/.env is an OLD blank template that stays tracked for now, so older checkouts can still pull;
# the server reads it only while backend/.env does not exist yet.
.env
.env.local
*.local
.DS_Store

# archives and duplicates of the 960 landscape frames (kept once, in aura-clone/dist/frames-webp)
*.zip
aura-clone-new
archive/papercub-react/public/frames-webp/

# editor / tooling
.claude/
__pycache__/

# the shop database (SQLite: orders, purchases) and PDFs uploaded through the admin API
database/data/
backend/protected/uploads/

# left behind on older checkouts after the move to frontend/ backend/ database/ (October 2026):
# react-app/node_modules and its old build, site/node_modules, site/data, site/protected/uploads
/react-app/
/site/*

