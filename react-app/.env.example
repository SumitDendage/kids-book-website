# Learn With Why — front-end settings (copy to .env.local and edit).
# Only PUBLIC values belong here: every VITE_ variable is baked into the
# JavaScript that visitors download. Never put the Razorpay key secret, the
# webhook secret, ADMIN_KEY, database details or any other secret in this file.
# (The Razorpay public key id is sent by the backend at checkout; it is not needed here.)

# Where the /api/* backend lives. Leave EMPTY when the backend is served from the
# same domain as the site (the normal setup): calls go to /api/... on the same host.
# Only set it if the API is on another domain, e.g. https://api.learnwithwhy.in
VITE_API_BASE_URL=

# Development only (npm run dev): where Vite forwards /api/* while you work.
# node site/server.cjs listens on http://127.0.0.1:4173 by default.
VITE_DEV_API_PROXY=http://127.0.0.1:4173
