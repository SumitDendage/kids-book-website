# Learn With Why — Apache / Hostinger settings for the React build.
# Upload this file together with the rest of dist/ into public_html/.
# HTTPS: switch on "Force HTTPS" for the domain in Hostinger hPanel (Security → SSL).

DirectoryIndex index.html
Options -MultiViews -Indexes

# _live is where Hostinger pulls each new build before it is copied into the site; never serve it.
RedirectMatch 404 ^/_live(/|$)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One address for the site: www.learnwithwhy.com moves to learnwithwhy.com (the address Google is told about).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # The backend API is never answered by the React app.
  RewriteRule ^api(/|$) - [L]

  # Real files and folders are served as they are: assets, fonts, frames,
  # preview frames, sheet thumbnails, robots.txt, sitemap.xml, viewer.html, ...
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing images, fonts and scripts stay a real 404 instead of returning the page.
  RewriteRule \.(?:m?js|css|map|json|webp|jpe?g|png|gif|svg|ico|woff2?|ttf|pdf|txt|xml)$ - [L,R=404]

  # /viewer is the sheet viewer page (the #t=… part stays in the browser).
  RewriteRule ^viewer/?$ viewer.html [L]

  # Every other path (/, /admin, /developer, ...) is a React route.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/ttf .ttf
  AddType image/svg+xml .svg
  AddType application/javascript .js .mjs
</IfModule>

<IfModule mod_headers.c>
  # Hashed build files never change: cache them for a year.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:m?js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The pages themselves are always re-checked so a new upload shows at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "viewer.html">
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Referrer-Policy "no-referrer"
  </Files>
  Header always set X-Content-Type-Options "nosniff"
  # Other sites may not show these pages inside a frame; the site never asks for the camera, microphone or location.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Staff and account pages never appear in search results. They are answered by index.html,
  # so the flag set from the address below is read under both names (before and after that rewrite).
  Header always set X-Robots-Tag "noindex, nofollow" env=LWW_NOINDEX
  Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_LWW_NOINDEX
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(admin|developer|account-blocked|viewer)(/|$)" LWW_NOINDEX=1
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml text/plain
</IfModule>
