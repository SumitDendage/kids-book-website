# Learn With Why: front-end settings (copy to .env.local and edit).
# Only PUBLIC values belong here: every VITE_ variable is baked into the
# JavaScript that visitors download. Never put a Razorpay, Stripe or PayPal
# secret, a Supabase secret key, database details or any other secret in this file.
# (The Razorpay public key id is sent by the API at checkout; it is not needed here.)

# Where the /api/* backend lives (the Supabase Edge Function "api").
# Leave it EMPTY to use the live API:
#   https://liaqgyskuhnxmlvmrnrl.supabase.co/functions/v1
# Set another address to use another API, for example a test project
# (https://<project>.supabase.co/functions/v1) or the local dev API
# (http://127.0.0.1:54321/functions/v1).
# Set it to /  (or the word same-origin) when the API is served from the site's
# own domain: calls then go to /api/... on the same host.
# Whatever address you use, the API must list this site's address in its
# allowed origins (ALLOWED_ORIGINS on the API), or the browser refuses the calls.
VITE_API_BASE_URL=

# Development only (npm run dev), and only when VITE_API_BASE_URL is / :
# where Vite forwards /api/* while you work.
VITE_DEV_API_PROXY=http://127.0.0.1:4173

# The AI assistant on the landing page. Leave EMPTY to use its practice answers
# (frontend/src/data/aiAssistant.js). Set to live to ask the API
# (POST /api/ai/chat with { "message": "..." } answers { "reply": "..." }).
VITE_AI_CHAT=
