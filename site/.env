# Learn With Why — server settings (site/.env)
#
# !! THIS FILE IS ON GITHUB WITH BLANK VALUES ONLY !!
# Fill in your real passwords on your own computer or server, but NEVER commit or push them:
# anyone who can see the repository could read them. Run this once after cloning, and Git will
# ignore your local edits to this file:
#
#     git update-index --skip-worktree site/.env
#
# Every setting is explained in site/.env.example. After changing this file, restart the server.

# ---------------------------------------------------------------- the website
# The public address of the site (links in emails point here). http://localhost:5173 while using npm run dev.
SITE_URL=http://localhost:4173
PORT=4173
# 0.0.0.0 on a server, so others can reach it
HOST=127.0.0.1
# NODE_ENV=production

# ---------------------------------------------------------------- PostgreSQL (customer accounts) — required
# Your own computer: the password you chose when installing PostgreSQL, and a database named lww.
# Neon / Supabase: paste the connection string they give you, and set DATABASE_SSL=require.
DATABASE_URL=postgres://postgres:YOUR-POSTGRES-PASSWORD@localhost:5432/lww
# DATABASE_SSL=require

# ---------------------------------------------------------------- email (SMTP)
# Empty = emails (password, Accept & Continue link, reset link) are printed in the terminal instead of sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your Gmail address, SMTP_PASS=a 16-letter app password,
#        MAIL_FROM=Learn With Why <the same Gmail address>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---------------------------------------------------------------- staff
# The password the admin panel uses (Admin → Settings → Server connection). Empty = "change-me".
ADMIN_KEY=

# ---------------------------------------------------------------- payments (off while empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
