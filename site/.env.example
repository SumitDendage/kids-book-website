# Learn With Why — server configuration. Copy to site/.env (git-ignored).

# Razorpay (Dashboard → Settings → API keys). Test keys start with rzp_test_, live with rzp_live_.
# Leave both empty to run the clearly labelled DEMO gateway (no money moves).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<your host>/api/pay/webhook, events payment.captured + order.paid + payment.failed
RAZORPAY_WEBHOOK_SECRET=

# Staff API key sent as the x-admin-key header by the admin panel
ADMIN_KEY=change-me

# Where the site is served from (https:// turns on the Secure cookie flag)
SITE_URL=http://127.0.0.1:4173
PORT=4173
HOST=127.0.0.1

# SQLite file (default site/data/lww.sqlite) and the private PDF store (default site/protected)
# DB_PATH=
# PROTECTED_DIR=

# Forgot-password codes: without an email service they are printed on the server console.
# 1 = also return the code to the browser (demo); 0 = never. Default: 1 unless NODE_ENV=production.
# RESET_CODE_IN_RESPONSE=0
# NODE_ENV=production
