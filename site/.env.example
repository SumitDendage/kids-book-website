# Learn With Why — server configuration. Copy to site/.env (git-ignored) and fill in what you need.
# Every line is optional: with nothing set, the site runs locally but takes no payments (checkout shows them as coming soon).
# Lines starting with # are notes. After changing this file, stop the server and start it again.

# ---------------------------------------------------------------- the website
# Where the site is served from. Use your real address once it is online (https:// turns on the
# Secure cookie flag). Stripe and PayPal send customers back to this address after paying.
SITE_URL=http://127.0.0.1:4173
PORT=4173
# 127.0.0.1 = only this computer can open the site. Use 0.0.0.0 on a server so others can reach it.
HOST=127.0.0.1

# The built React site. Default: react-app/dist (made by "npm run build" in react-app), and the
# old site/dist if that folder does not exist. A relative path is read from the site/ folder.
# STATIC_DIR=../react-app/dist

# Only if the React site lives on a DIFFERENT domain than this server (VITE_API_BASE_URL is set
# in react-app): the exact addresses allowed to call the API with the customer's login cookie,
# separated by commas. Leave empty when the site and the API share one address (the normal setup).
# CORS_ORIGINS=https://www.learnwithwhy.in

# ---------------------------------------------------------------- staff
# The password the admin panel sends (Settings → Server connection). Change it before going online.
ADMIN_KEY=change-me

# ---------------------------------------------------------------- Razorpay (UPI, QR, cards, wallets)
# Dashboard → Settings → API keys. Test keys start with rzp_test_, live with rzp_live_.
# Leave both empty and Razorpay is off: card / QR / UPI / wallet show as "Coming soon" and nothing can be bought.
# To try payments locally without moving money, use test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<your host>/api/pay/webhook, events payment.captured + order.paid + payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Stripe (optional, cards worldwide)
# dashboard.stripe.com → Developers → API keys → "Secret key" (sk_test_… to try it, sk_live_… for real).
# Empty = Stripe shows as "Coming soon" at checkout.
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------- PayPal (optional)
# developer.paypal.com → Apps & Credentials → your app's Client ID and Secret.
# PAYPAL_MODE: sandbox (test money, the default) or live (real money; use the live app's keys).
# Empty = PayPal shows as "Coming soon" at checkout.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------- email (optional)
# Contact-form notes are always saved in the database and shown in the admin Messages panel.
# To ALSO email each note to the shop (and email password-reset codes to customers), make a free
# account at resend.com, verify your domain, and fill in both lines below.
# RESEND_API_KEY=re_...
# MAIL_FROM=Learn With Why <hello@learnwithwhy.in>
# Where contact-form notes are emailed (default learnwithwhy6@gmail.com).
# CONTACT_INBOX=learnwithwhy6@gmail.com

# ---------------------------------------------------------------- storage
# SQLite file (default site/data/lww.sqlite) and the private PDF store (default site/protected)
# DB_PATH=
# PROTECTED_DIR=

# ---------------------------------------------------------------- password reset
# Without an email service the six-digit codes are printed on the server console.
# 1 = also show the code in the browser (demo); 0 = never. Default: 1 unless NODE_ENV=production.
# RESET_CODE_IN_RESPONSE=0
# NODE_ENV=production
