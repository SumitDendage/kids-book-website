# Learn With Why — server configuration. Copy to site/.env (git-ignored) and fill in what you need.
# Required: DATABASE_URL. For real customers also SITE_URL, ADMIN_KEY and the email (SMTP) lines.
# Everything else has a working default. Lines starting with # are notes.
# After changing this file, stop the server and start it again.

# ---------------------------------------------------------------- the website
# The public address of the site, with no trailing slash. The links in account emails
# (Accept & Continue, password reset) point here, and Stripe / PayPal send customers back here.
# https:// also turns on the Secure cookie flag. In development with `npm run dev` in react-app,
# use http://localhost:5173 so the email links open the Vite dev server.
SITE_URL=http://localhost:4173
PORT=4173
# 127.0.0.1 = only this computer can open the site. Use 0.0.0.0 on a server so others can reach it.
HOST=127.0.0.1
# production turns on the production defaults: TLS to the database, no "console" email.
# NODE_ENV=production

# The built React site. Default: react-app/dist (made by "npm run build" in react-app), and the
# old site/dist if that folder does not exist. A relative path is read from the site/ folder.
# STATIC_DIR=../react-app/dist

# Only if the React site lives on a DIFFERENT domain than this server (VITE_API_BASE_URL is set
# in react-app): the exact addresses allowed to call the API with the customer's login cookie,
# separated by commas. Leave empty when the site and the API share one address (the normal setup).
# CORS_ORIGINS=https://www.learnwithwhy.in

# ---------------------------------------------------------------- PostgreSQL (customer accounts)
# The database for users, email confirmation and password-reset tokens, sessions, login activity
# and security events. The tables are created / updated automatically at every start
# (site/db/migrations), or with `npm run migrate`.
#   local:      postgres://lww:CHANGE-ME@127.0.0.1:5432/lww
#   managed:    copy the connection string your provider gives you (Neon, Supabase, Render, …)
DATABASE_URL=postgres://lww:CHANGE-ME@127.0.0.1:5432/lww
# disable (local database) | require (TLS, certificate checked — the default with NODE_ENV=production)
# | no-verify (TLS without checking the certificate; only if your provider tells you to)
# DATABASE_SSL=disable
# Connections the server keeps open (default 10).
# PG_POOL_MAX=10

# ---------------------------------------------------------------- email (SMTP)
# Sign-up emails the customer their generated password and the Accept & Continue link, and
# Forgot password emails a reset link — so a real mail service is needed for customers.
# Any SMTP provider works. Examples:
#   Gmail / Google Workspace  SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
#   Hostinger mail            SMTP_HOST=smtp.hostinger.com SMTP_PORT=465  SMTP_USER=hello@learnwithwhy.in
#   Brevo                     SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#   Resend                    SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_...
# SMTP_SECURE: true for port 465 (TLS from the start), false for 587 (STARTTLS). Default: true only on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=false
# The sender customers see. Must be an address your SMTP account may send from.
MAIL_FROM=Learn With Why <hello@learnwithwhy.in>
# Only the Resend API key (no SMTP_HOST) also works: it is used as Resend's SMTP password.
# RESEND_API_KEY=re_...
# Without SMTP: in development every email is printed in the server log instead (MAIL_TRANSPORT=console);
# with NODE_ENV=production sign-up and password reset answer "email is not set up" until SMTP is filled in.
# MAIL_TRANSPORT=console
# Where contact-form notes are emailed (default learnwithwhy6@gmail.com).
# CONTACT_INBOX=learnwithwhy6@gmail.com

# ---------------------------------------------------------------- accounts (defaults shown)
# How long the Accept & Continue link works, and the password-reset link.
# EMAIL_VERIFY_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=30
# "Keep me signed in": days the session lasts; without it, hours. Refreshing never goes past SESSION_MAX_DAYS.
# SESSION_DAYS=30
# SESSION_HOURS=12
# SESSION_MAX_DAYS=90
# Wrong passwords in a row before the account locks, and for how long.
# LOGIN_MAX_FAILED=5
# LOGIN_LOCK_MINUTES=15

# ---------------------------------------------------------------- staff
# The password the admin panel sends (Settings → Server connection). Change it before going online.
ADMIN_KEY=change-me

# ---------------------------------------------------------------- Razorpay (UPI, QR, cards, wallets)
# Dashboard → Settings → API keys. Test keys start with rzp_test_, live with rzp_live_.
# Leave both empty and Razorpay is off: card / QR / UPI / wallet show as "Coming soon" and nothing can be bought.
# To try payments locally without moving money, use test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → URL https://<your host>/api/pay/webhook, events payment.captured + order.paid + payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Stripe (optional, cards worldwide)
# dashboard.stripe.com → Developers → API keys → "Secret key" (sk_test_… to try it, sk_live_… for real).
# Empty = Stripe shows as "Coming soon" at checkout.
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------- PayPal (optional)
# developer.paypal.com → Apps & Credentials → your app's Client ID and Secret.
# PAYPAL_MODE: sandbox (test money, the default) or live (real money; use the live app's keys).
# Empty = PayPal shows as "Coming soon" at checkout.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------- shop storage
# The shop's SQLite file (catalogue, orders, entitlements; default site/data/lww.sqlite) and the
# private PDF store (default site/protected).
# DB_PATH=
# PROTECTED_DIR=
